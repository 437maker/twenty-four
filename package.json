{
  "name": "twenty-four",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ship": "npx --yes eas-cli update --channel main --platform ios --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~7.11.0",
    "date-fns": "^3.6.0",
    "expo": "^55.0.0",
    "expo-auth-session": "~55.0.19",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "tslib": "^2.8.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "app/utils/**/*.{ts,tsx}",
      "app/db/**/*.{ts,tsx}",
      "app/store/**/*.{ts,tsx}",
      "!app/**/*.d.ts"
    ],
    "globalSetup": "./jest.global-setup.js"
  },
  "private": true
}
