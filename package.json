{
  "name": "twenty-four",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ship": "npx --yes eas-cli update --channel main --platform ios --environment production",
    "render:companion": "node --no-warnings scripts/render-companion.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.28.0",
    "date-fns": "^3.6.0",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tslib": "^2.8.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "app/utils/**/*.{ts,tsx}",
      "app/db/**/*.{ts,tsx}",
      "app/store/**/*.{ts,tsx}",
      "!app/**/*.d.ts"
    ],
    "globalSetup": "./jest.global-setup.js",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  },
  "private": true
}
